# YouTube Downloader Configuration

# Download Settings
DOWNLOAD_DIR=downloads
VIDEOS_PER_CHANNEL=2
MAX_QUALITY=best[height<=1080]

# Server Configuration
HOST=127.0.0.1
PORT=5001
DEBUG=false

# Authentication (Optional - leave blank to disable)

# ADMIN_PASSWORD=change_me_please
  # Skip auth for local network (10.x, 172.16-31.x, 192.168.x, 127.x)

# Plex Integration (Optional - for automatic thumbnail uploads)
# PLEX_URL=http://your-plex-server:32400
# PLEX_TOKEN=your_plex_token_here
# PLEX_LIBRARY_ID=your_library_id
